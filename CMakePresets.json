{
  "version": 3,
  "configurePresets": [
    {
      "name": "pico",
      "displayName": "Raspberry Pi Pico (RP2040)",
      "description": "Standard build for Raspberry Pi Pico RP2040 using arm-none-eabi-gcc",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-pico",
      "cacheVariables": {
        "QSAC_TARGET_PICO": "ON",
        "QSAC_TARGET_HOST": "OFF",
        "PICO_BOARD": "pico",
        "QSAC_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "pico",
      "configurePreset": "pico"
    }
  ]
}
